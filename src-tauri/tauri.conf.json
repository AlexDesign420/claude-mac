{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Claude Mac App",
  "version": "0.1.0",
  "identifier": "com.alexdesign420.claudemacapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Mac App",
        "width": 1560,
        "height": 980,
        "minWidth": 1240,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../.sidecar-bundle"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
